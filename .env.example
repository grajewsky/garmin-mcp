POSTGRES_PASSWORD=change-me
# Opcjonalnie: ścieżka do pliku z kluczem Garmin (domyślnie ~/.config/garmin-mcp/api-key)
GARMIN_API_KEY_FILE=
# Opcjonalnie: port Postgresa na hoście (domyślnie 5432)
# POSTGRES_PORT=5432
# Opcjonalnie: UID/GID użytkownika hosta będącego właścicielem pliku klucza (domyślnie 1000; sprawdź `id -u`, `id -g`)
# APP_UID=1000
# APP_GID=1000
